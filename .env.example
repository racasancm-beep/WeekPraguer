# Database
DATABASE_URL="postgresql://user:password@localhost:5432/weekend_space_booker"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-key-here"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe
STRIPE_PUBLIC_KEY="pk_test_your_stripe_public_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Email (Optional - for notifications)
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="noreply@weekendspacebooker.com"

# SMS Provider (Optional - Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Salto KS API (Optional - for access management)
SALTO_API_KEY="your-salto-api-key"
SALTO_API_URL="https://api.saltoks.com"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLATFORM_COMMISSION_RATE="0.14"
CLEANING_FEE_RATE="0.10"
INSURANCE_RATE="0.50"

# AI Integration (Claude 3.5 Sonnet)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Stripe Subscriptions
# Create these prices in your Stripe Dashboard -> Products
STRIPE_PREMIUM_PRICE_ID="price_..."
STRIPE_ULTIMATE_PRICE_ID="price_..."
