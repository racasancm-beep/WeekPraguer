generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  name                 String?
  password             String?
  role                 UserRole
  emailVerified        DateTime?
  image                String?
  phone                String?
  verified             Boolean          @default(false)
  idDocument           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  subscriptionTier     SubscriptionTier @default(FREE)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  subscriptionActive   Boolean          @default(false)
  subscriptionEnd      DateTime?
  aiUsageCount         Int              @default(0)
  lastAiUsageDate      DateTime?
  companyName          String?
  vatId                String?
  billingAddress       String?
  serviceRadius        Int?
  availabilitySlots    String?
  accounts             Account[]
  bookings             Booking[]        @relation("BookingRenter")
  reviews              Review[]         @relation("ReviewAuthor")
  receivedReviews      Review[]         @relation("ReviewSubject")
  sessions             Session[]
  ownedSpaces          Space[]          @relation("SpaceOwner")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Space {
  id            String       @id @default(cuid())
  ownerId       String
  name          String
  description   String
  address       String
  city          String       @default("Madrid")
  district      String?
  latitude      Float?
  longitude     Float?
  size          Int
  capacity      Int
  category      String?
  officeCount   Int?
  hasWifi       Boolean      @default(true)
  hasProjector  Boolean      @default(false)
  hasKitchen    Boolean      @default(false)
  hasParking    Boolean      @default(false)
  hasAC         Boolean      @default(false)
  amenitiesList String?
  hourlyRate    Float
  dailyRate     Float
  weekendRate   Float
  active        Boolean      @default(true)
  isClean       Boolean      @default(true)
  selfCleaning  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  bookings      Booking[]
  reviews       Review[]
  photos        SpacePhoto[]
  owner         User         @relation("SpaceOwner", fields: [ownerId], references: [id])

  @@map("spaces")
}

model SpacePhoto {
  id        String   @id @default(cuid())
  spaceId   String
  url       String
  createdAt DateTime @default(now())
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("space_photos")
}

model Booking {
  id              String        @id @default(cuid())
  spaceId         String
  renterId        String
  startTime       DateTime
  endTime         DateTime
  isHourly        Boolean       @default(false)
  basePrice       Float
  cleaningFee     Float
  insurance       Float
  totalPrice      Float
  commission      Float
  ownerEarnings   Float         @default(0)
  adminEarnings   Float         @default(0)
  status          BookingStatus @default(PENDING)
  accessCode      String?
  paymentId       String?
  termsAcceptedAt DateTime?
  termsAcceptedIp String?
  proposedStartTime DateTime?
  proposedEndTime DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  renter          User          @relation("BookingRenter", fields: [renterId], references: [id])
  space           Space         @relation(fields: [spaceId], references: [id])
  reviews         Review[]
  transaction     Transaction?

  @@map("bookings")
}

model Transaction {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  amount          Float
  currency        String        @default("EUR")
  stripePaymentId String?
  paymentStatus   PaymentStatus @default(PENDING)
  payoutCompleted Boolean       @default(false)
  payoutDate      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking       @relation(fields: [bookingId], references: [id])

  @@map("transactions")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String?
  spaceId   String?
  authorId  String
  subjectId String?
  rating    Int
  comment   String?
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  booking   Booking? @relation(fields: [bookingId], references: [id])
  space     Space?   @relation(fields: [spaceId], references: [id])
  subject   User?    @relation("ReviewSubject", fields: [subjectId], references: [id])

  @@map("reviews")
}

enum UserRole {
  OWNER
  RENTER
  ADMIN
}

enum BookingStatus {
  REJECTED
  OWNER_PROPOSED
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionTier {
  FREE
  PREMIUM
  ULTIMATE
}

